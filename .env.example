# Copy to .env (repo root) and fill in. Never commit .env.

# API
API_PORT=3000

# Neon PostgreSQL connection string (Neon console > Connect).
# - Use the direct (non "-pooler") host: later phases rely on transactions
#   and session behavior that PgBouncer transaction pooling can break.
# - Use sslmode=verify-full. node-postgres treats "require" the same way but
#   prints a security warning; drop channel_binding (node-postgres ignores it).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
